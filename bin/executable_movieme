#!/bin/sh
#
# MOVIE ME as in: "MOVIE ME AN ANIMATED GIF FROM THIS MOVIE, DAMMIT"
#
# Creates an animated gif from a movie file, written next to the source file
# with a .gif extension.
#
#   $1 - the path to the movie we're converting.
#   $2 - the start time of the finished product.
#        This can be in seconds, or it also accepts the "hh:mm:ss[.xxx]" format.
#   $3 - the duration of the video sequence.
#        This can be in seconds, or it also accepts the "hh:mm:ss[.xxx]" format.
#
# Examples:
#
#   movieme <path> <start-time> <duration>
#   ~/Desktop/dr-strangelove.mp4 23:12 3
#   ~/Desktop/holman-backflip-on-fire.mov 3.9 1.75

out="${1%.*}.gif"

# single-pass extract + encode, using a generated palette for quality
# (avoids the old frame-dir + gifme two-step, and the temp-file handling
# that came with it)
ffmpeg -y -ss "$2" -i "$1" -t "$3" \
    -vf "fps=7,scale=iw*sar:ih:flags=lanczos,split[s0][s1];[s0]palettegen[p];[s1][p]paletteuse" \
    -loop 0 "$out"
